<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>bzh.lusk.texte</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Lusk Texte</name>
  <summary>Write books and documents; open and save Word files</summary>
  <summary xml:lang="fr">Écrire des livres et des documents ; ouvrir et enregistrer des fichiers Word</summary>
  <developer id="bzh.lusk">
    <name>Lusk (association loi 1901)</name>
  </developer>
  <description>
    <p>
      Lusk Texte is a free, open-source word processor that keeps what you write on your computer. It reads and writes .docx, ODT, RTF, HTML and Markdown files and exports PDF, with styles, tables, track changes and references. Its Book mode lays out novels, essays and poetry for print and e-readers: structure, front matter, running heads, cover studio, print-ready PDF, accessible EPUB, quality checks and version history.
    </p>
    <p xml:lang="fr">
      Lusk Texte est un traitement de texte libre qui garde ce que vous écrivez sur votre ordinateur. Il lit et écrit les fichiers .docx, ODT, RTF, HTML et Markdown et exporte en PDF, avec styles, tableaux, suivi des modifications et références. Son Mode Livre met en page romans, essais et poésie pour l'impression et les liseuses : structure, pages liminaires, titres courants, studio de couverture, PDF pour l'imprimeur, EPUB accessible, contrôle qualité et historique des versions.
    </p>
  </description>
  <launchable type="desktop-id">bzh.lusk.texte.desktop</launchable>
  <icon type="stock">bzh.lusk.texte</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://www.lusk.bzh</url>
  <url type="bugtracker">https://github.com/declic29/lusktx/issues</url>
  <url type="help">https://github.com/declic29/lusktx</url>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>word processor</keyword>
    <keyword>docx</keyword>
    <keyword>document</keyword>
    <keyword>writer</keyword>
    <keyword>book</keyword>
    <keyword>epub</keyword>
    <keyword xml:lang="fr">traitement de texte</keyword>
    <keyword xml:lang="fr">livre</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>A brochure being edited in Lusk Texte</caption>
      <caption xml:lang="fr">Une brochure en cours d'écriture dans Lusk Texte</caption>
      <image>https://raw.githubusercontent.com/declic29/LuskTX/main/docs/images/hero.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#a8e0df</color>
    <color type="primary" scheme_preference="dark">#0f5e5d</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <!-- Document types Lusk Texte opens (#295), as in the desktop entry's MimeType=. -->
  <provides>
    <binary>wordcraft</binary>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.document</mediatype>
    <mediatype>application/vnd.ms-word.document.macroEnabled.12</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.template</mediatype>
    <mediatype>application/vnd.ms-word.template.macroEnabled.12</mediatype>
    <mediatype>application/msword</mediatype>
    <mediatype>application/msword-template</mediatype>
    <mediatype>application/vnd.oasis.opendocument.text</mediatype>
    <mediatype>application/rtf</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
